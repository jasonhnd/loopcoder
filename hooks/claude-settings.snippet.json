{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/conductor-attest.js",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node hooks/conductor-relay-guard.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/conductor-attest.js",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node hooks/conductor-relay-guard.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
