{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|pwsh",
        "hooks": [
          {
            "type": "command",
            "command": "loopcoder hook conductor-reporter",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "loopcoder hook conductor-relay-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "loopcoder hook conductor-reporter",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "loopcoder hook conductor-relay-guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
